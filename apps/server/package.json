{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "check:types": "tsc -b",
    "clean": "rimraf node_modules",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "NODE_ENV=development bun run --hot src/index.ts",
    "start": "NODE_ENV=production bun run dist/index.js"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/openapi": "^1.4.16",
    "@elysiajs/server-timing": "^1.4.1",
    "@im-debug-better-app/api": "workspace:*",
    "@im-debug-better-app/db": "workspace:*",
    "@logtape/logtape": "catalog:",
    "dotenv": "catalog:",
    "elysia": "catalog:",
    "get-port": "^7.2.0"
  },
  "devDependencies": {
    "@im-debug-better-app/config": "workspace:*",
    "typescript": "catalog:"
  }
}
