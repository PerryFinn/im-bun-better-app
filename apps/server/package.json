{
  "name": "server",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "NODE_ENV=production bun run dist/index.js"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.3.3",
    "@elysiajs/openapi": "^1.4.11",
    "@elysiajs/trpc": "^1.1.0",
    "@im-debug-better-app/api": "workspace:*",
    "@im-debug-better-app/db": "workspace:*",
    "@trpc/server": "catalog:",
    "dotenv": "catalog:",
    "elysia": "catalog:",
    "get-port": "^7.1.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@im-debug-better-app/config": "workspace:*",
    "tsdown": "^0.16.5",
    "typescript": "catalog:"
  }
}
