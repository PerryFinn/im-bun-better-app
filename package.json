{
  "name": "im-debug-better-app",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "elysia": "^1.4.30",
      "@elysiajs/eden": "^1.4.9",
      "dotenv": "^18.0.8",
      "zod": "^4.6.7",
      "typescript": "^7.0.2",
      "lucide-react": "^1.61.0",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "@types/node": "^24.13.3",
      "@types/react": "~19.3.0",
      "@types/react-dom": "^19.3.0",
      "postcss": "^8.5.31",
      "tailwindcss": "^4.3.3",
      "drizzle-orm": "^0.45.4",
      "@types/bun": "^1.4.3",
      "@logtape/logtape": "^2.4.2",
      "pathe": "^2.0.3"
    }
  },
  "scripts": {
    "build": "turbo build",
    "build:bun": "NODE_ENV=production bun run ./scripts/package-server-distribution.ts",
    "check": "bun run --bun ultracite check",
    "check:types": "turbo check:types",
    "clean:build": "turbo run clean:build && rimraf dist build .tsbuildinfo",
    "clean:node_modules": "turbo run clean:node_modules && rimraf node_modules",
    "clean:turbo": "turbo run clean:turbo && rimraf .turbo",
    "db:generate": "turbo -F @im-debug-better-app/db db:generate",
    "db:migrate": "turbo -F @im-debug-better-app/db db:migrate",
    "db:push": "turbo -F @im-debug-better-app/db db:push",
    "db:studio": "turbo -F @im-debug-better-app/db db:studio",
    "dev": "turbo dev",
    "dev:server": "turbo -F server dev",
    "dev:web": "turbo -F web dev",
    "fix": "bun run --bun ultracite fix",
    "prepare": "husky",
    "verify": "bun run check && bun run check:types"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "bun run --bun ultracite check --diagnostic-level error"
    ]
  },
  "dependencies": {
    "pathe": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "rimraf": "^6.1.3",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "ultracite": "8.1.0"
  },
  "packageManager": "bun@1.4.4"
}
