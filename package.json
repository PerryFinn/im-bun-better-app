{
  "name": "im-debug-better-app",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "elysia": "^1.4.29",
      "@elysiajs/eden": "^1.4.9",
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^7.0.2",
      "lucide-react": "^1.28.0",
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "@types/node": "^24.13.3",
      "@types/react": "~19.2.18",
      "@types/react-dom": "^19.2.4",
      "postcss": "^8.5.25",
      "tailwindcss": "^4.3.3",
      "drizzle-orm": "^0.45.2",
      "@types/bun": "^1.3.14",
      "@logtape/logtape": "^2.3.0",
      "pathe": "^2.0.3"
    }
  },
  "scripts": {
    "check": "ultracite check",
    "fix": "ultracite fix",
    "check:types": "turbo check:types",
    "verify": "bun run check && bun run check:types",
    "prepare": "husky",
    "dev": "turbo dev",
    "build": "turbo build",
    "build:bun": "NODE_ENV=production bun run ./scripts/build.ts",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @im-debug-better-app/db db:push",
    "db:studio": "turbo -F @im-debug-better-app/db db:studio",
    "db:generate": "turbo -F @im-debug-better-app/db db:generate",
    "db:migrate": "turbo -F @im-debug-better-app/db db:migrate"
  },
  "dependencies": {
    "pathe": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/bun": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "turbo": "^2.10.8",
    "typescript": "catalog:",
    "ultracite": "7.9.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "bun x ultracite check --diagnostic-level error"
    ]
  },
  "packageManager": "bun@1.3.14"
}
