{
  "name": "im-debug-better-app",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "elysia": "^1.4.25",
      "@trpc/server": "^11.5.0",
      "dotenv": "^17.3.1",
      "zod": "^4.3.6",
      "typescript": "^5.9.3",
      "lucide-react": "^0.473.0",
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "@trpc/client": "^11.5.0",
      "@types/node": "^22.13.13",
      "@types/react": "~19.2.7",
      "@types/react-dom": "^19.2.3",
      "postcss": "^8.5.3",
      "tailwindcss": "^4.0.15",
      "drizzle-orm": "^0.45.1",
      "@types/bun": "^1.3.9",
      "@logtape/logtape": "^1.3.5"
    }
  },
  "scripts": {
    "check": "ultracite check",
    "fix": "ultracite fix",
    "check:types": "turbo check:types",
    "verify": "bun run check",
    "prepare": "husky",
    "dev": "turbo dev",
    "build": "turbo build",
    "build:bun": "NODE_ENV=production bun run ./scripts/build.ts",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @im-debug-better-app/db db:push",
    "db:studio": "turbo -F @im-debug-better-app/db db:studio",
    "db:generate": "turbo -F @im-debug-better-app/db db:generate",
    "db:migrate": "turbo -F @im-debug-better-app/db db:migrate"
  },
  "dependencies": {
    "@logtape/logtape": "catalog:",
    "dotenv": "catalog:",
    "elysia": "catalog:",
    "pathe": "^2.0.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@types/bun": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "turbo": "^2.8.7",
    "ultracite": "7.1.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "bun x ultracite check --diagnostic-level error"
    ]
  },
  "packageManager": "bun@1.3.9"
}
