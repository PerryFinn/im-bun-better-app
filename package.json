{
  "name": "im-debug-better-app",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "elysia": "^1.4.19",
      "@trpc/server": "^11.5.0",
      "dotenv": "^17.2.2",
      "zod": "^4.1.11",
      "typescript": "^5.8.2",
      "lucide-react": "^0.473.0",
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "@trpc/client": "^11.5.0",
      "@types/node": "^22.13.13",
      "@types/react": "~19.2.7",
      "@types/react-dom": "^19.2.3",
      "postcss": "^8.5.3",
      "tailwindcss": "^4.0.15",
      "drizzle-orm": "^0.44.2",
      "@types/bun": "^1.3.5"
    }
  },
  "scripts": {
    "check": "biome check --write .",
    "prepare": "husky",
    "dev": "turbo dev",
    "build": "turbo build",
    "build:bun": "bun run ./scripts/build.ts",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @im-debug-better-app/db db:push",
    "db:studio": "turbo -F @im-debug-better-app/db db:studio",
    "db:generate": "turbo -F @im-debug-better-app/db db:generate",
    "db:migrate": "turbo -F @im-debug-better-app/db db:migrate"
  },
  "dependencies": {
    "dotenv": "catalog:",
    "elysia": "catalog:",
    "pathe": "^2.0.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.9",
    "@types/bun": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "turbo": "^2.6.3",
    "ultracite": "6.4.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "bun x ultracite fix"
    ]
  },
  "packageManager": "bun@1.3.4"
}
